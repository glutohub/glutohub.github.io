----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local noop = function() end

local function Fire(cb, ...)
    if type(cb) == "function" then task.spawn(cb, ...) end
end

local function CopyTable(t)
    local n = {}
    for k, v in pairs(t) do n[k] = v end
    return n
end

local function Clamp(v, a, b) return math.max(a, math.min(b, v)) end
local function Trim(s) return (tostring(s or ""):gsub("^%s*(.-)%s*$", "%1")) end
local function GetCamera() return Workspace.CurrentCamera end
local function RandomName() return "Claux_" .. HttpService:GenerateGUID(false):sub(1, 8) end

local function Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Claux.Connections, c)
    return c
end

local function Tween(inst, props, time, style, dir)
    local t = TweenService:Create(inst, TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

-- Instance factory: every GuiObject starts transparent, borderless.
local function New(class, props)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then
        inst.BorderSizePixel = 0
        inst.BackgroundTransparency = 1
        if inst:IsA("GuiButton") then inst.AutoButtonColor = false end
    end
    if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        inst.Font = FONT
        inst.TextSize = 12
    end
    local parent
    if props then
        for k, v in pairs(props) do
            if k == "Parent" then parent = v else inst[k] = v end
        end
    end
    if parent then inst.Parent = parent end
    return inst
end

----------------------------------------------------------------------
-- Themes (Neverlose-style presets)
----------------------------------------------------------------------
local BaseTheme = {
    Background   = RGB(12, 12, 14),
    Topbar       = RGB(14, 14, 17),
    Section      = RGB(15, 15, 18),
    SectionTop   = RGB(23, 23, 28),
    Element      = RGB(20, 20, 24),
    ElementHover = RGB(27, 27, 33),
    Outline      = RGB(32, 32, 38),
    ToggleOff    = RGB(42, 42, 50),
    Text         = RGB(235, 235, 235),
    SubText      = RGB(140, 140, 152),
    Accent       = RGB(0, 116, 224),
    AccentLight  = RGB(0, 195, 255),
    Danger       = RGB(255, 90, 90),
    Warning      = RGB(255, 170, 0),
    Success      = RGB(70, 215, 120),
}

local function MakeTheme(over)
    local t = CopyTable(BaseTheme)
    for k, v in pairs(over) do t[k] = v end
    return t
end

local Themes = {
    Neverlose = BaseTheme,
    Midnight  = MakeTheme({
        Background = RGB(13, 12, 18), Topbar = RGB(16, 15, 22), Section = RGB(17, 16, 24),
        SectionTop = RGB(26, 24, 36), Element = RGB(22, 21, 31), ElementHover = RGB(30, 28, 42),
        Outline = RGB(36, 34, 50), ToggleOff = RGB(46, 44, 62),
        Accent = RGB(124, 92, 255), AccentLight = RGB(176, 140, 255),
    }),
    Crimson   = MakeTheme({ Accent = RGB(214, 40, 70), AccentLight = RGB(255, 110, 130) }),
    Emerald   = MakeTheme({ Accent = RGB(16, 163, 110), AccentLight = RGB(72, 225, 170) }),
}
Claux.Theme = CopyTable(BaseTheme)

local ThemeBindings, ThemeCallbacks = {}, {}

local function BindTheme(inst, prop, key)
    pcall(function() inst[prop] = Claux.Theme[key] end)
    table.insert(ThemeBindings, { Inst = inst, Prop = prop, Key = key })
end

local function OnTheme(inst, fn)
    fn(Claux.Theme)
    table.insert(ThemeCallbacks, { Inst = inst, Fn = fn })
end

local function ApplyTheme()
    local root = Claux.Gui
    if not root then return end
    for i = #ThemeBindings, 1, -1 do
        local b = ThemeBindings[i]
        if b.Inst:IsDescendantOf(root) then
            pcall(function() b.Inst[b.Prop] = Claux.Theme[b.Key] end)
        else
            table.remove(ThemeBindings, i)
        end
    end
    for i = #ThemeCallbacks, 1, -1 do
        local c = ThemeCallbacks[i]
        if c.Inst:IsDescendantOf(root) then
            pcall(c.Fn, Claux.Theme)
        else
            table.remove(ThemeCallbacks, i)
        end
    end
end

function Claux:SetTheme(name)
    local t = Themes[name]
    if not t then return false end
    self.ThemeName = name
    self.Theme = CopyTable(t)
    ApplyTheme()
    return true
end

function Claux:SetAccent(color, light)
    if typeof(color) ~= "Color3" then return end
    self.Theme.Accent = color
    self.Theme.AccentLight = light or color:Lerp(Color3.new(1, 1, 1), 0.35)
    ApplyTheme()
end

function Claux:AddTheme(name, overrides)
    if type(name) == "string" and type(overrides) == "table" then
        Themes[name] = MakeTheme(overrides)
    end
end

function Claux:GetThemes()
    local list = {}
    for name in pairs(Themes) do table.insert(list, name) end
    table.sort(list)
    return list
end

