function Claux:_UpdateBlur()
    local want = false
    for _, w in ipairs(self.Windows) do
        if w.Visible and w.BlurEnabled then want = true end
    end
    if want then
        if not self.Blur or not self.Blur.Parent then
            self.Blur = New("BlurEffect", { Name = RandomName(), Size = 0, Parent = GetCamera() or Lighting })
        end
        Tween(self.Blur, { Size = 14 }, 0.25)
    elseif self.Blur and self.Blur.Parent then
        Tween(self.Blur, { Size = 0 }, 0.25)
    end
end

