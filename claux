function Claux:SetWatermark(enabled, title)
    if not enabled then
        if self.Watermark then self.Watermark.Visible = false end
        return
    end
    EnsureGui()
    if not self.Watermark or not self.Watermark.Parent then
        local f = New("Frame", {
            Name = "Watermark", Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(0, 26),
            AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 0, ZIndex = 60, Parent = self.Gui,
        })
        BindTheme(f, "BackgroundColor3", "Section")
        Corner(f, 6)
        Stroke(f, "Outline")
        Pad(f, 10, 10, 0, 0)
        local line = New("Frame", { Size = UDim2.new(1, 20, 0, 2), Position = UDim2.fromOffset(-10, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = f })
        AccentGradient(line, 0)
        local text = New("TextLabel", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = "", Font = FONT_MED, TextSize = 12, Parent = f })
        BindTheme(text, "TextColor3", "Text")
        self.Watermark, self.WatermarkText = f, text

        local frames, elapsed, fps = 0, 0, 60
        Connect(RunService.Heartbeat, function(dt)
            frames = frames + 1
            elapsed = elapsed + dt
            if elapsed >= 0.5 then
                fps = math.floor(frames / elapsed + 0.5)
                frames, elapsed = 0, 0
                if self.Watermark and self.Watermark.Visible then
                    local ping = 0
                    pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
                    self.WatermarkText.Text = string.format("%s  |  %s  |  %d fps  |  %d ms", self.WatermarkTitle or "Claux", LocalPlayer.DisplayName, fps, ping)
                end
            end
        end)
    end
    self.WatermarkTitle = title or self.WatermarkTitle or "Claux"
    self.Watermark.Visible = true
end

