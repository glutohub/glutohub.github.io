function SectionMethods:AddButton(cfg)
    if type(cfg) == "string" then cfg = { Title = cfg } end
    cfg = cfg or {}
    local R = MakeRow(self, cfg)
    local btn = New("TextButton", {
        Size = UDim2.fromOffset(cfg.Width or 76, 22), Text = cfg.Text or cfg.ButtonName or "Click",
        Font = FONT_MED, TextSize = 12, BackgroundTransparency = 0, Parent = R.Right,
    })
    BindTheme(btn, "BackgroundColor3", "Background")
    BindTheme(btn, "TextColor3", "Text")
    Corner(btn, 5)
    Stroke(btn, "Outline")

    local El = { Type = "Button" }
    function El:Press()
        Tween(btn, { BackgroundColor3 = Claux.Theme.Accent }, 0.08)
        task.delay(0.12, function()
            if btn.Parent then Tween(btn, { BackgroundColor3 = Claux.Theme.Background }, 0.2) end
        end)
        Fire(cfg.Callback)
    end
    function El:SetText(t) btn.Text = tostring(t) end
    btn.Activated:Connect(function() El:Press() end)
    R.Hit.Activated:Connect(function() El:Press() end)
    return Finish(self, El, R, cfg, "Button", { NoRegister = true })
end

function SectionMethods:AddToggle(cfg)
    cfg = cfg or {}
    local R = MakeRow(self, cfg)
    local track = New("TextButton", {
        Size = UDim2.fromOffset(34, 18), Text = "", BackgroundTransparency = 0,
        BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 10, Parent = R.Right,
    })
    Corner(track, 9)
    local grad = New("UIGradient", { Parent = track })
    local knob = New("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = track })
    Corner(knob, 6)

    local El = { Type = "Toggle", Value = cfg.Default == true }
    local function Paint()
        local t = Claux.Theme
        if El.Value then
            grad.Color = ColorSequence.new(t.Accent, t.AccentLight)
        else
            grad.Color = ColorSequence.new(t.ToggleOff, t.ToggleOff)
        end
        Tween(knob, { Position = El.Value and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3) }, 0.12)
    end
    OnTheme(track, function() Paint() end)

    function El:Get() return self.Value end
    function El:Set(v, silent)
        v = v and true or false
        local changed = v ~= self.Value
        self.Value = v
        Paint()
        SyncFlag(self)
        if not silent and changed then
            Claux:_Changed(self)
            self:_Fire()
        end
    end
    function El:_Fire() Fire(cfg.Callback, self.Value) end
    function El:_Export() return self.Value end
    function El:_Import(v) self:Set(v == true or v == 1, true) end

    track.Activated:Connect(function() El:Set(not El.Value) end)
    R.Hit.Activated:Connect(function() El:Set(not El.Value) end)

    -- Inline widgets on the same row (Neverlose style)
    function El:AddKeybind(kcfg)
        kcfg = kcfg or {}
        local kb = MakeKeybind(R.Right, kcfg, El, 1)
        RegisterElement("Keybind", { Title = kb.TitleText, Flag = kcfg.Flag, Save = kcfg.Save }, kb)
        return kb
    end
    function El:AddColorPicker(ccfg)
        ccfg = ccfg or {}
        local cp = MakeColorPicker(R.Right, ccfg, 2)
        RegisterElement("ColorPicker", { Title = ccfg.Title or ((El.TitleText or "Toggle") .. " Color"), Flag = ccfg.Flag, Save = ccfg.Save }, cp)
        task.defer(function() cp:_Fire() end)
        return cp
    end

    return Finish(self, El, R, cfg, "Toggle", { Fire = true })
end

function SectionMethods:AddSlider(cfg)
    cfg = cfg or {}
    local min, max = cfg.Min or 0, cfg.Max or 100
    local inc = cfg.Increment or (cfg.Decimals and (10 ^ -cfg.Decimals)) or 1
    local suffix = cfg.Suffix or ""

    local function Snap(val)
        val = Clamp(val, min, max)
        if inc > 0 then val = math.floor((val - min) / inc + 0.5) * inc + min end
        local dec = tostring(inc):match("%.(%d+)")
        val = tonumber(string.format("%." .. (dec and #dec or 0) .. "f", val)) or val
        return Clamp(val, min, max)
    end

    local R = MakeRow(self, cfg, { RightTop = true })
    local box = New("TextBox", {
        Size = UDim2.fromOffset(58, 20), Text = "", ClearTextOnFocus = false, TextSize = 11, Font = FONT_MED,
        BackgroundTransparency = 0, Parent = R.Right,
    })
    BindTheme(box, "BackgroundColor3", "Background")
    BindTheme(box, "TextColor3", "Text")
    Corner(box, 4)
    Stroke(box, "Outline")

    local Extra = New("TextButton", { Size = UDim2.new(1, 0, 0, 18), Text = "", LayoutOrder = 2, Parent = R.Inner })
    local Bar = New("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.new(1, -20, 0, 4), BackgroundTransparency = 0, Parent = Extra })
    BindTheme(Bar, "BackgroundColor3", "ToggleOff")
    Corner(Bar, 2)
    local Fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = Bar })
    Corner(Fill, 2)
    AccentGradient(Fill, 0)
    local Knob = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), Position = UDim2.fromScale(0, 0.5), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = Bar })
    Corner(Knob, 5)

    local El = { Type = "Slider", Value = Snap(tonumber(cfg.Default) or min) }
    local function Paint()
        local a = (max == min) and 0 or (El.Value - min) / (max - min)
        Fill.Size = UDim2.fromScale(a, 1)
        Knob.Position = UDim2.fromScale(a, 0.5)
        box.Text = tostring(El.Value) .. suffix
    end

    function El:Get() return self.Value end
    function El:Set(val, silent)
        val = tonumber(val)
        if not val then return end
        val = Snap(val)
        local changed = val ~= self.Value
        self.Value = val
        Paint()
        SyncFlag(self)
        if not silent and changed then
            Claux:_Changed(self)
            self:_Fire()
        end
    end
    function El:_Fire() Fire(cfg.Callback, self.Value) end
    function El:_Export() return self.Value end
    function El:_Import(val) self:Set(val, true) end

    Draggable(Extra, function(pos)
        local a = Clamp((pos.X - Bar.AbsolutePosition.X) / math.max(Bar.AbsoluteSize.X, 1), 0, 1)
        El:Set(min + (max - min) * a)
    end, self.Tab.Page)

    box.Focused:Connect(function() box.Text = tostring(El.Value) end)
    box.FocusLost:Connect(function()
        local n = tonumber((box.Text:gsub("[^%d%.%-]", "")))
        if n then El:Set(n) end
        Paint()
    end)

    Paint()
    return Finish(self, El, R, cfg, "Slider", { Fire = true })
end

function SectionMethods:AddDropdown(cfg)
    cfg = cfg or {}
    local multi = cfg.Multi == true
    local El = { Type = "Dropdown", Multi = multi, Options = {}, Selected = {}, Value = nil }
    for _, o in ipairs(cfg.Options or cfg.Values or {}) do table.insert(El.Options, o) end

    if multi then
        local d = cfg.Default
        if type(d) == "table" then
            for _, o in ipairs(d) do El.Selected[o] = true end
        elseif d ~= nil then
            El.Selected[d] = true
        end
    else
        El.Value = cfg.Default
    end

    local R = MakeRow(self, cfg)
    local chip = New("TextButton", { Size = UDim2.fromOffset(cfg.Width or 130, 22), Text = "", BackgroundTransparency = 0, Parent = R.Right })
    BindTheme(chip, "BackgroundColor3", "Background")
    Corner(chip, 5)
    Stroke(chip, "Outline")
    local chipText = New("TextLabel", {
        Size = UDim2.new(1, -26, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = chip,
    })
    BindTheme(chipText, "TextColor3", "Text")
    local arrow = MakeIcon(chip, "chevron-down", 12, "SubText", "v")
    arrow.AnchorPoint = Vector2.new(1, 0.5)
    arrow.Position = UDim2.new(1, -6, 0.5, 0)

    local function IsSel(o)
        if multi then return El.Selected[o] == true end
        return El.Value == o
    end

    local function CurrentList()
        local list = {}
        for _, o in ipairs(El.Options) do
            if El.Selected[o] then list[#list + 1] = o end
        end
        for o in pairs(El.Selected) do
            if not table.find(El.Options, o) then list[#list + 1] = o end
        end
        return list
    end

    local Pop, Search, ListFrame
    local Btns, Paints = {}, {}
    local Rebuild

    function El:_Refresh()
        if multi then
            local l = CurrentList()
            if #l == 0 then
                chipText.Text = "None"
            else
                local parts = {}
                for i, o in ipairs(l) do parts[i] = tostring(o) end
                chipText.Text = table.concat(parts, ", ")
            end
        else
            chipText.Text = (self.Value ~= nil) and tostring(self.Value) or "None"
        end
        for _, p in ipairs(Paints) do p() end
        SyncFlag(self)
    end

    function El:Get()
        if multi then return CurrentList() end
        return self.Value
    end

    function El:Set(v, silent)
        if multi then
            self.Selected = {}
            if type(v) == "table" then
                for _, o in ipairs(v) do self.Selected[o] = true end
            elseif v ~= nil then
                self.Selected[v] = true
            end
        else
            self.Value = v
        end
        self:_Refresh()
        if not silent then
            Claux:_Changed(self)
            self:_Fire()
        end
    end

    function El:_Fire() Fire(cfg.Callback, self:Get()) end
    function El:_Export() return self:Get() end
    function El:_Import(v) self:Set(v, true) end

    function El:Refresh(list, default)
        self.Options = {}
        for _, o in ipairs(list or {}) do table.insert(self.Options, o) end
        if default ~= nil then
            self:Set(default, true)
        elseif multi then
            for o in pairs(self.Selected) do
                if not table.find(self.Options, o) then self.Selected[o] = nil end
            end
        elseif self.Value ~= nil and not table.find(self.Options, self.Value) then
            self.Value = nil
        end
        self:_Refresh()
        if Pop then Rebuild() end
    end
    El.SetValues = El.Refresh
    function El:AddOption(o)
        if not table.find(self.Options, o) then
            table.insert(self.Options, o)
            self:_Refresh()
            if Pop then Rebuild() end
        end
    end
    function El:RemoveOption(o)
        local i = table.find(self.Options, o)
        if i then
            table.remove(self.Options, i)
            if multi then self.Selected[o] = nil elseif self.Value == o then self.Value = nil end
            self:_Refresh()
            if Pop then Rebuild() end
        end
    end
    function El:Clear() self:Refresh({}) end

    Rebuild = function()
        for _, b in ipairs(Btns) do b:Destroy() end
        Btns, Paints = {}, {}
        if not ListFrame then return end
        local q = string.lower(Search.Text or "")
        for i, o in ipairs(El.Options) do
            local txt = tostring(o)
            if q == "" or string.find(string.lower(txt), q, 1, true) then
                local b = New("TextButton", { Size = UDim2.new(1, 0, 0, 24), Text = "", LayoutOrder = i, Parent = ListFrame })
                Corner(b, 5)
                local l = New("TextLabel", {
                    Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(8, 0), Text = txt, Font = FONT_MED, TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
                })
                local mark = New("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(6, 6), BackgroundTransparency = 0, Parent = b })
                Corner(mark, 3)
                local function paint()
                    local sel = IsSel(o)
                    l.TextColor3 = sel and Claux.Theme.Accent or Claux.Theme.Text
                    mark.BackgroundColor3 = Claux.Theme.Accent
                    mark.Visible = sel
                end
                paint()
                Paints[#Paints + 1] = paint
                b.MouseEnter:Connect(function()
                    b.BackgroundColor3 = Claux.Theme.Element
                    b.BackgroundTransparency = 0
                end)
                b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
                b.Activated:Connect(function()
                    if multi then
                        El.Selected[o] = (not El.Selected[o]) or nil
                        El:_Refresh()
                        Claux:_Changed(El)
                        El:_Fire()
                    else
                        El:Set(o)
                        Claux:_ClosePopup()
                    end
                end)
                Btns[#Btns + 1] = b
            end
        end
    end

    local function BuildPop()
        Pop = New("Frame", { Visible = false, BackgroundTransparency = 0, ZIndex = 2, Parent = Claux.PopupLayer })
        BindTheme(Pop, "BackgroundColor3", "Background")
        Corner(Pop, 6)
        Stroke(Pop, "Outline")
        Search = New("TextBox", {
            Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 24), Text = "", PlaceholderText = "Search...",
            ClearTextOnFocus = false, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 0, Parent = Pop,
        })
        BindTheme(Search, "BackgroundColor3", "Element")
        BindTheme(Search, "TextColor3", "Text")
        BindTheme(Search, "PlaceholderColor3", "SubText")
        Corner(Search, 5)
        Pad(Search, 8, 8, 0, 0)
        ListFrame = New("ScrollingFrame", {
            Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8), CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, Parent = Pop,
        })
        BindTheme(ListFrame, "ScrollBarImageColor3", "Accent")
        List(ListFrame, 1)
        Search:GetPropertyChangedSignal("Text"):Connect(function() Rebuild() end)
    end

    local function Open()
        if not Pop then BuildPop() end
        local useSearch = cfg.Search == true or (cfg.Search ~= false and #El.Options > 8)
        Search.Visible = useSearch
        ListFrame.Position = useSearch and UDim2.fromOffset(4, 34) or UDim2.fromOffset(4, 4)
        ListFrame.Size = useSearch and UDim2.new(1, -8, 1, -38) or UDim2.new(1, -8, 1, -8)
        Search.Text = ""
        Rebuild()
        local h = math.max(40, math.min(#El.Options * 25 + 8 + (useSearch and 30 or 0), 230))
        Claux:_OpenPopup(chip, Pop, math.max(chip.AbsoluteSize.X, 150), h)
    end
    chip.Activated:Connect(Open)
    R.Hit.Activated:Connect(Open)

    El:_Refresh()
    return Finish(self, El, R, cfg, "Dropdown", { Fire = true })
end

function SectionMethods:AddInput(cfg)
    cfg = cfg or {}
