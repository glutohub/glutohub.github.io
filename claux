    end
    if cfg.Discord and tostring(cfg.Discord) ~= "" then
        IconButton(2, "message-circle", "D", function() JoinDiscord(cfg.Discord) end)
    end
    IconButton(3, "minus", "-", function() Window:SetVisible(false) end)
    IconButton(4, "x", "x", function()
        self:Confirm("Close " .. Window.Title, "UI akan di-unload sepenuhnya. Config tetap tersimpan.", "Unload", function() self:Unload() end)
    end)

    local topLine = New("Frame", { Position = UDim2.fromOffset(0, TOP), Size = UDim2.new(1, 0, 0, 1), BackgroundTransparency = 0, Parent = Main })
    BindTheme(topLine, "BackgroundColor3", "Outline")

    -- sidebar
    local Sidebar = New("Frame", { Position = UDim2.fromOffset(0, TOP + 1), Size = UDim2.new(0, tabWidth, 1, -(TOP + 1)), Parent = Main })
    local TabList = New("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -52), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 0, Parent = Sidebar,
    })
    Pad(TabList, 8, 8, 8, 8)
    List(TabList, 3)

    local Profile = New("Frame", { Position = UDim2.new(0, 0, 1, -52), Size = UDim2.new(1, 0, 0, 52), Parent = Sidebar })
    local pLine = New("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundTransparency = 0, Parent = Profile })
    BindTheme(pLine, "BackgroundColor3", "Outline")
    local Avatar = New("ImageLabel", { Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(30, 30), BackgroundTransparency = 0, Parent = Profile })
    BindTheme(Avatar, "BackgroundColor3", "Element")
    Corner(Avatar, 15)
    task.spawn(function()
        local ok, img = pcall(function()
            return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        if ok and img and Avatar.Parent then Avatar.Image = img end
    end)
    local pName = New("TextLabel", {
        Position = UDim2.fromOffset(48, 10), Size = UDim2.new(1, -54, 0, 15), Text = LocalPlayer.DisplayName, Font = FONT_MED, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Profile,
    })
    BindTheme(pName, "TextColor3", "Text")
    local pSub = New("TextLabel", {
        Position = UDim2.fromOffset(48, 26), Size = UDim2.new(1, -54, 0, 12),
        Text = (cfg.Author and tostring(cfg.Author) ~= "") and tostring(cfg.Author) or ("@" .. LocalPlayer.Name), TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Profile,
    })
    BindTheme(pSub, "TextColor3", "SubText")

    local vLine = New("Frame", { Position = UDim2.fromOffset(tabWidth, TOP + 1), Size = UDim2.new(0, 1, 1, -(TOP + 1)), BackgroundTransparency = 0, Parent = Main })
    BindTheme(vLine, "BackgroundColor3", "Outline")

    -- content
    local Content = New("Frame", { Position = UDim2.fromOffset(tabWidth + 1, TOP + 1), Size = UDim2.new(1, -(tabWidth + 1), 1, -(TOP + 1)), Parent = Main })
    local PageTitle = New("TextLabel", {
        Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 20), Text = "", Font = FONT_BOLD, TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = Content,
    })
    BindTheme(PageTitle, "TextColor3", "Text")
    local Pages = New("Frame", { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), Parent = Content })

    local SearchPage = New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3, Visible = false, Parent = Pages,
    })
    BindTheme(SearchPage, "ScrollBarImageColor3", "Accent")
    Pad(SearchPage, 10, 12, 4, 10)
    List(SearchPage, 6)

    Window.Holder, Window.Main, Window.UIScale = Holder, Main, UIScaleObj
    Window.TabList, Window.Pages, Window.PageTitle, Window.SearchPage = TabList, Pages, PageTitle, SearchPage

    SearchBox:GetPropertyChangedSignal("Text"):Connect(function() Window:_RunSearch(SearchBox.Text) end)

    -- dragging (the resize handle from Chloex is intentionally NOT included)
    local dragging, dragStart, startPos = false, nil, nil
    Topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Holder.Position
        end
    end)
    Connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            local c = GetCamera()
            local v = c and c.ViewportSize or Vector2.new(1280, 720)
            local half = Holder.AbsoluteSize / 2
            local nx = Clamp(startPos.X.Offset + d.X, -(v.X / 2 + half.X - 60), v.X / 2 + half.X - 60)
            local ny = Clamp(startPos.Y.Offset + d.Y, -(v.Y / 2 - half.Y), v.Y / 2 + half.Y - 40)
            Holder.Position = UDim2.new(startPos.X.Scale, nx, startPos.Y.Scale, ny)
        end
    end)
    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- floating logo button (shown when minimised, always on mobile)
    local logoSize = cfg.LogoButtonSize or 50
    local LogoBtn = New("TextButton", {
        Name = "LogoButton", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 20, 0.5, 0),
        Size = UDim2.fromOffset(logoSize, logoSize), Text = "", BackgroundTransparency = 0, Visible = IsMobile, ZIndex = 50, Parent = self.Gui,
    })
    BindTheme(LogoBtn, "BackgroundColor3", "Background")
    Corner(LogoBtn, math.floor(logoSize / 2))
    Stroke(LogoBtn, "Accent", 1.5)
    local lg = MakeLogo(LogoBtn, logoSize - 16, cfg.Image)
    lg.AnchorPoint = Vector2.new(0.5, 0.5)
    lg.Position = UDim2.fromScale(0.5, 0.5)
    Window.LogoButton = LogoBtn

    local ldrag, lstart, lpos, moved = false, nil, nil, false
    LogoBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ldrag, moved = true, false
            lstart, lpos = input.Position, LogoBtn.Position
        end
    end)
    Connect(UserInputService.InputChanged, function(input)
        if ldrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - lstart
            if d.Magnitude > 6 then moved = true end
            if moved then LogoBtn.Position = UDim2.new(lpos.X.Scale, lpos.X.Offset + d.X, lpos.Y.Scale, lpos.Y.Offset + d.Y) end
        end
    end)
    Connect(UserInputService.InputEnded, function(input)
        if ldrag and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            ldrag = false
            if not moved then Window:Toggle() end
        end
    end)

    -- menu key
    local MenuBind = { Key = ParseKey(cfg.ToggleKey or cfg.MenuKey) or Enum.KeyCode.Insert, Hidden = true }
    function MenuBind:_Press(code)
        if self.Key and code == self.Key then Window:Toggle() end
    end
    function MenuBind:_Release() end
    table.insert(self.Keybinds, MenuBind)
    Window.MenuBind = MenuBind

    Window:SetVisible(true)

    -- settings tab + autoload (deferred so the script can finish building its own tabs first)
    if cfg.Settings ~= false then
        task.defer(function()
            if not Window.SettingsTab then Window:AddSettingsTab() end
        end)
    end
    task.defer(function()
        task.wait(0.5)
        local auto = self:GetAutoLoad()
        if auto ~= "" then
            local ok = self:LoadConfigByName(auto)
            if ok then self:Notify({ Title = "Config", Content = "Auto load: " .. auto, Type = "Success", Duration = 3 }) end
        end
    end)

    return Window
end

