    local box = New("TextBox", {
        Size = UDim2.fromOffset(cfg.Width or 130, 22), Text = tostring(cfg.Default or ""), PlaceholderText = cfg.Placeholder or "Type here...",
        ClearTextOnFocus = false, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 0, Parent = R.Right,
    })
    BindTheme(box, "BackgroundColor3", "Background")
    BindTheme(box, "TextColor3", "Text")
    BindTheme(box, "PlaceholderColor3", "SubText")
    Corner(box, 5)
    local st = Stroke(box, "Outline")
    Pad(box, 8, 8, 0, 0)

    local El = { Type = "Input", Value = box.Text }
    function El:Get() return self.Value end
    function El:Set(val, silent)
        self._setting = true
        box.Text = tostring(val or "")
        self._setting = false
        self.Value = box.Text
        SyncFlag(self)
        if not silent then
            Claux:_Changed(self)
            self:_Fire()
        end
    end
    function El:_Fire() Fire(cfg.Callback, cfg.Numeric and tonumber(self.Value) or self.Value) end
    function El:_Export() return self.Value end
    function El:_Import(val) self:Set(val, true) end

    box:GetPropertyChangedSignal("Text"):Connect(function()
        if El._setting then return end
        if cfg.Numeric then
            local f = box.Text:gsub("[^%d%.%-]", "")
            if f ~= box.Text then
                box.Text = f
                return
            end
        end
        El.Value = box.Text
        SyncFlag(El)
        if cfg.Finished == false then
            Claux:_Changed(El)
            El:_Fire()
        end
    end)
    box.Focused:Connect(function() Tween(st, { Color = Claux.Theme.Accent }, 0.12) end)
    box.FocusLost:Connect(function()
        Tween(st, { Color = Claux.Theme.Outline }, 0.12)
        if cfg.Finished ~= false then
            Claux:_Changed(El)
            El:_Fire()
        end
    end)
    R.Hit.Activated:Connect(function() box:CaptureFocus() end)

    return Finish(self, El, R, cfg, "Input", { Fire = cfg.FireOnInit == true })
end

