local function Corner(parent, r)
    return New("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = parent })
end

local function Stroke(parent, key, thickness)
    local s = New("UIStroke", { Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
    BindTheme(s, "Color", key or "Outline")
    return s
end

local function Pad(parent, l, r, t, b)
    return New("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0),
        PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
        Parent = parent,
    })
end

local function List(parent, padding, dir, halign, valign)
    return New("UIListLayout", {
        Padding = UDim.new(0, padding or 0),
        FillDirection = dir or Enum.FillDirection.Vertical,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
        VerticalAlignment = valign or Enum.VerticalAlignment.Top,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = parent,
    })
end

local function AccentGradient(parent, rotation)
    local g = New("UIGradient", { Rotation = rotation or 0, Parent = parent })
    OnTheme(parent, function(t) g.Color = ColorSequence.new(t.Accent, t.AccentLight) end)
    return g
end

----------------------------------------------------------------------
-- File system helpers
----------------------------------------------------------------------
local HasFS = type(writefile) == "function" and type(readfile) == "function"
    and type(isfile) == "function" and type(isfolder) == "function" and type(makefolder) == "function"

local function EnsureFolder(path)
    if not HasFS then return end
    local current = ""
    for part in string.gmatch(path, "[^/\\]+") do
        current = (current == "") and part or (current .. "/" .. part)
        local ok, exists = pcall(isfolder, current)
        if ok and not exists then pcall(makefolder, current) end
    end
end

local function EnsureFolderForFile(path)
    local dir = path:match("^(.*)[/\\][^/\\]+$")
    if dir then EnsureFolder(dir) end
end

local function SafeRead(path)
    if not HasFS or not path then return nil end
    local ok, exists = pcall(isfile, path)
    if not ok or not exists then return nil end
    local ok2, data = pcall(readfile, path)
    if ok2 and type(data) == "string" and data ~= "" then return data end
    return nil
end

local function SafeWrite(path, data)
    if not HasFS or not path then return false end
    EnsureFolderForFile(path)
    return (pcall(writefile, path, data))
end

local function SafeJSONDecode(str)
    local ok, res = pcall(function() return HttpService:JSONDecode(str) end)
    if ok then return res end
    return nil
end

local function JSONEncode(t)
    local ok, res = pcall(function() return HttpService:JSONEncode(t) end)
    if ok then return res end
    return "{}"
end

local function SanitizeName(name)
    name = tostring(name or "")
    name = name:gsub("[^%w_ %-]", "")
    name = name:gsub("%s+", "_")
    return name
end

local B64CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function B64Encode(data)
    local out = {}
    for i = 1, #data, 3 do
        local a, b, c = string.byte(data, i, i + 2)
        local n = a * 65536 + (b or 0) * 256 + (c or 0)
        local c1 = math.floor(n / 262144) % 64
        local c2 = math.floor(n / 4096) % 64
        local c3 = math.floor(n / 64) % 64
        local c4 = n % 64
        out[#out + 1] = B64CHARS:sub(c1 + 1, c1 + 1) .. B64CHARS:sub(c2 + 1, c2 + 1)
            .. (b and B64CHARS:sub(c3 + 1, c3 + 1) or "=") .. (c and B64CHARS:sub(c4 + 1, c4 + 1) or "=")
    end
    return table.concat(out)
end

local function B64Decode(data)
    data = data:gsub("[^%w%+/=]", "")
    local map = {}
    for i = 1, #B64CHARS do map[B64CHARS:sub(i, i)] = i - 1 end
    local out = {}
    for i = 1, #data, 4 do
        local s = data:sub(i, i + 3)
        local c1, c2 = map[s:sub(1, 1)], map[s:sub(2, 2)]
        local c3, c4 = map[s:sub(3, 3)], map[s:sub(4, 4)]
        if not c1 or not c2 then break end
        local n = c1 * 262144 + c2 * 4096 + (c3 or 0) * 64 + (c4 or 0)
        out[#out + 1] = string.char(math.floor(n / 65536) % 256)
        if c3 then out[#out + 1] = string.char(math.floor(n / 256) % 256) end
        if c4 then out[#out + 1] = string.char(n % 256) end
    end
    return table.concat(out)
end

local function SetClipboard(text)
    local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
    if fn then return (pcall(fn, text)) end
    return false
end

----------------------------------------------------------------------
-- Icons (Lucide) + logo
----------------------------------------------------------------------
local Lucide, LucideTried
local LucideCache = {}

local function GetLucide()
    if LucideTried then return Lucide end
    LucideTried = true
    local ok, res = pcall(function()
        return loadstring(game:HttpGet("https://github.com/latte-soft/lucide-roblox/releases/latest/download/lucide-roblox.luau"))()
    end)
    if ok and type(res) == "table" then Lucide = res end
    return Lucide
end

local function ApplyIcon(img, name, size)
    if type(name) ~= "string" or name == "" then return false end
    if name:match("^rbxassetid://") or name:match("^rbxthumb://") or name:match("^%d+$") then
        img.Image = name:match("^%d+$") and ("rbxassetid://" .. name) or name
        return true
    end
    local lib = GetLucide()
    if lib then
        local asset = LucideCache[name]
        if asset == nil then
            local ok, res = pcall(function() return lib.GetAsset(name, 48) end)
            asset = (ok and res) or false
            LucideCache[name] = asset
        end
        if asset then
            img.Image = asset.Url
            img.ImageRectOffset = asset.ImageRectOffset
            img.ImageRectSize = asset.ImageRectSize
            return true
        end
    end
    return false
end

-- Returns holder (Frame of size x size) and the inner icon instance (or nil).
local function MakeIcon(parent, name, size, colorKey, fallback)
    size = size or 16
    local holder = New("Frame", { Size = UDim2.fromOffset(size, size), Parent = parent })
    local img = New("ImageLabel", { Size = UDim2.fromScale(1, 1), Parent = holder })
    local ok = ApplyIcon(img, name, size)
    local inner = img
    if ok then
        if colorKey then BindTheme(img, "ImageColor3", colorKey) end
    else
        img:Destroy()
        inner = nil
        if fallback then
            inner = New("TextLabel", {
                Size = UDim2.fromScale(1, 1), Text = fallback, Font = FONT_BOLD,
                TextSize = math.max(10, size - 2), Parent = holder,
            })
            if colorKey then BindTheme(inner, "TextColor3", colorKey) end
        end
    end
    return holder, inner
end

local function ResolveImage(image)
    if image == nil or image == "" then return nil end
    image = tostring(image)
    if image:match("^%d+$") then return "rbxassetid://" .. image end
    if image:match("^rbxassetid://") or image:match("^rbxthumb://") or image:match("^rbxasset://") then return image end
    if image:match("^https?://") and HasFS and type(getcustomasset) == "function" then
        local sum = 0
        for i = 1, #image do sum = (sum * 31 + image:byte(i)) % 2147483647 end
        local path = "Claux/Assets/" .. sum .. ".png"
        if not isfile(path) then
            local ok, data = pcall(function() return game:HttpGet(image) end)
            if not ok or not data then return nil end
            SafeWrite(path, data)
        end
        local ok, asset = pcall(getcustomasset, path)
        if ok then return asset end
    end
    return nil
end

local function MakeLogo(parent, size, image)
    local holder = New("Frame", { Size = UDim2.fromOffset(size, size), Parent = parent })
    Corner(holder, math.floor(size * 0.28))
    local resolved = ResolveImage(image)
    if resolved then
        local img = New("ImageLabel", { Size = UDim2.fromScale(1, 1), Image = resolved, Parent = holder })
        Corner(img, math.floor(size * 0.28))
    else
        holder.BackgroundTransparency = 0
        holder.BackgroundColor3 = Color3.new(1, 1, 1)
        AccentGradient(holder, 45)
        New("TextLabel", {
            Size = UDim2.fromScale(1, 1), Text = "C", Font = FONT_BOLD,
            TextSize = math.floor(size * 0.6), TextColor3 = Color3.new(1, 1, 1), Parent = holder,
        })
    end
    return holder
end

----------------------------------------------------------------------
-- Global GUI root, drag manager, keybind dispatcher, popups
----------------------------------------------------------------------
local ActiveDrag, ActiveDragPage

-- Generic "press and drag" helper (sliders, colour picker areas...)
local function Draggable(btn, cb, page)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ActiveDrag = cb
            if page then
                page.ScrollingEnabled = false
                ActiveDragPage = page
            end
            cb(input.Position)
        end
    end)
end

local function SetupInput()
    Connect(UserInputService.InputChanged, function(input)
        if ActiveDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            ActiveDrag(input.Position)
        end
    end)

    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ActiveDrag = nil
            if ActiveDragPage then
                ActiveDragPage.ScrollingEnabled = true
                ActiveDragPage = nil
            end
        elseif input.UserInputType == Enum.UserInputType.Keyboard then
            for _, kb in ipairs(Claux.Keybinds) do
                if kb._Release then kb:_Release(input.KeyCode) end
            end
        end
    end)

    Connect(UserInputService.InputBegan, function(input, processed)
        if Claux.Listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local el = Claux.Listening
                Claux.Listening = nil
                if input.KeyCode == Enum.KeyCode.Escape then el:SetKey(nil) else el:SetKey(input.KeyCode) end
            end
            return
        end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if UserInputService:GetFocusedTextBox() then return end

        -- Search shortcuts (Ctrl+O / Ctrl+Shift+F), same as Chloex
        local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        if ctrl and ((input.KeyCode == Enum.KeyCode.O) or (shift and input.KeyCode == Enum.KeyCode.F)) then
            for _, w in ipairs(Claux.Windows) do
                if w.Visible then w:FocusSearch() end
            end
            return
        end

        if processed then return end
        for _, kb in ipairs(Claux.Keybinds) do
            if kb._Press then kb:_Press(input.KeyCode) end
        end
    end)
end

local function EnsureGui()
    if Claux.Gui and Claux.Gui.Parent then return Claux.Gui end

    local gui = New("ScreenGui", {
        Name = RandomName(), ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 9999,
    })
    if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end

    local parent
    if type(gethui) == "function" then
        local ok, h = pcall(gethui)
        if ok and typeof(h) == "Instance" then parent = h end
    end
    local ok = pcall(function() gui.Parent = parent or CoreGui end)
    if not ok or not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    Claux.Gui = gui

    Claux.PopupLayer = New("Frame", { Name = "Popups", Size = UDim2.fromScale(1, 1), ZIndex = 100, Parent = gui })
    Claux.PopupCatcher = New("TextButton", { Size = UDim2.fromScale(1, 1), Text = "", Visible = false, ZIndex = 1, Parent = Claux.PopupLayer })
    Connect(Claux.PopupCatcher.Activated, function() Claux:_ClosePopup() end)

    Claux.NotifyHolder = New("Frame", {
        Name = "Notifications", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.new(0, 300, 1, -32), ZIndex = 200, Parent = gui,
    })
    List(Claux.NotifyHolder, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)

    SetupInput()
    return gui
end

function Claux:_OpenPopup(anchor, frame, w, h, onClose)
    self:_ClosePopup()
    local cam = GetCamera()
    local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
    local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
    local x = Clamp(ap.X + as.X - w, 6, math.max(6, vp.X - w - 6))
    local y = ap.Y + as.Y + 4
    if y + h > vp.Y - 6 then y = math.max(6, ap.Y - h - 4) end
    frame.Size = UDim2.fromOffset(w, h)
    frame.Position = UDim2.fromOffset(x, y)
    frame.Visible = true
    self.PopupCatcher.Visible = true
    self.CurrentPopup = { Frame = frame, OnClose = onClose }
end

function Claux:_ClosePopup()
    local p = self.CurrentPopup
    self.CurrentPopup = nil
    if p then
        p.Frame.Visible = false
        if p.OnClose then pcall(p.OnClose) end
    end
    if self.PopupCatcher then self.PopupCatcher.Visible = false end
end

function Claux:Confirm(title, text, yesText, onYes)
    EnsureGui()
    local overlay = New("TextButton", {
        Size = UDim2.fromScale(1, 1), Text = "", BackgroundTransparency = 0.45,
        BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 400, Parent = self.Gui,
    })
    local card = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 0, Parent = overlay,
    })
    BindTheme(card, "BackgroundColor3", "Background")
    Corner(card, 10)
    Stroke(card, "Outline")
    Pad(card, 16, 16, 14, 14)
    List(card, 8)

    local t = New("TextLabel", { Size = UDim2.new(1, 0, 0, 20), Text = title or "Confirm", Font = FONT_BOLD, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = card })
    BindTheme(t, "TextColor3", "Text")
    local d = New("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = text or "", TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextSize = 12, LayoutOrder = 2, Parent = card })
    BindTheme(d, "TextColor3", "SubText")

    local row = New("Frame", { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 3, Parent = card })
    List(row, 8, Enum.FillDirection.Horizontal)

    local function MakeBtn(text2, accent, cb)
        local b = New("TextButton", { Size = UDim2.new(0.5, -4, 1, 0), Text = text2, Font = FONT_MED, TextSize = 12, BackgroundTransparency = 0, Parent = row })
        Corner(b, 6)
        if accent then
            b.BackgroundColor3 = Color3.new(1, 1, 1)
            AccentGradient(b, 0)
            b.TextColor3 = Color3.new(1, 1, 1)
        else
            BindTheme(b, "BackgroundColor3", "Element")
            BindTheme(b, "TextColor3", "Text")
            Stroke(b, "Outline")
        end
        b.Activated:Connect(cb)
        return b
    end
    MakeBtn("Cancel", false, function() overlay:Destroy() end)
    MakeBtn(yesText or "Yes", true, function()
        overlay:Destroy()
        Fire(onYes)
    end)
end

----------------------------------------------------------------------
-- Notifications
----------------------------------------------------------------------
local ActiveNotifs = {}

function Claux:Notify(cfg)
    if type(cfg) == "string" then cfg = { Content = cfg } end
    cfg = cfg or {}
    if self.NotificationsEnabled == false and not cfg.Force then return end
    EnsureGui()

    local keyMap = { Info = "Accent", Success = "Success", Warning = "Warning", Error = "Danger", Danger = "Danger" }
    local color = cfg.Color or self.Theme[keyMap[cfg.Type or "Info"] or "Accent"]
    local duration = cfg.Duration or cfg.Delay or 4

    self.NotifyCount = (self.NotifyCount or 0) + 1
    local wrap = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self.NotifyCount, Parent = self.NotifyHolder })
    local card = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(1, 40, 0, 0), BackgroundTransparency = 0, Parent = wrap,
    })
    BindTheme(card, "BackgroundColor3", "Section")
    Corner(card, 8)
    Stroke(card, "Outline")

    local stripe = New("Frame", { Size = UDim2.new(0, 3, 1, -14), Position = UDim2.fromOffset(6, 7), BackgroundTransparency = 0, BackgroundColor3 = color, Parent = card })
    Corner(stripe, 2)

    local body = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
    Pad(body, 18, 12, 9, 13)
    List(body, 2)

    local title = New("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Text = cfg.Title or "Claux", Font = FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = body })
    BindTheme(title, "TextColor3", "Text")

    if cfg.Description and cfg.Description ~= "" then
        local sub = New("TextLabel", { Size = UDim2.new(1, 0, 0, 13), Text = cfg.Description, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = body })
        BindTheme(sub, "TextColor3", "SubText")
    end

    local content = cfg.Content or cfg.Text or ""
    if content ~= "" then
        local c = New("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = content, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextSize = 12, LayoutOrder = 3, Parent = body })
        BindTheme(c, "TextColor3", "Text")
    end

    local bar = New("Frame", { Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 2), BackgroundTransparency = 0.25, BackgroundColor3 = color, Parent = card })
    local click = New("TextButton", { Size = UDim2.fromScale(1, 1), Text = "", Parent = card })

    local closed = false
    local function Close()
        if closed then return end
        closed = true
        local idx = table.find(ActiveNotifs, Close)
        if idx then table.remove(ActiveNotifs, idx) end
        Tween(card, { Position = UDim2.new(1, 40, 0, 0) }, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.3, function() wrap:Destroy() end)
    end
    click.Activated:Connect(Close)

    table.insert(ActiveNotifs, Close)
    if #ActiveNotifs > 5 then
        local oldest = ActiveNotifs[1]
        oldest()
    end

    Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.3, Enum.EasingStyle.Quint)
    Tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
    task.delay(duration, Close)

    return { Close = Close }
end
