function WindowMethods:AddTab(tcfg)
    if type(tcfg) == "string" then tcfg = { Name = tcfg } end
    tcfg = tcfg or {}

    local Tab = setmetatable({
        Window = self, Name = tostring(tcfg.Name or tcfg.Title or "Tab"), Icon = tcfg.Icon,
        Active = false, Locked = false, SectionCount = 0,
    }, TabMethods)

    local btn = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), Text = "", BackgroundTransparency = 1,
        LayoutOrder = tcfg.Order or (#self.Tabs + 1), Parent = self.TabList,
    })
    BindTheme(btn, "BackgroundColor3", "Element")
    Corner(btn, 6)

    local bar = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(3, 14),
        BackgroundTransparency = 1, BackgroundColor3 = Color3.new(1, 1, 1), Parent = btn,
    })
    Corner(bar, 2)
    AccentGradient(bar, 90)

    local textX, iconInner = 12, nil
    if tcfg.Icon and tcfg.Icon ~= "" then
        local holder, inner = MakeIcon(btn, tcfg.Icon, 16, "SubText", nil)
        holder.AnchorPoint = Vector2.new(0, 0.5)
        holder.Position = UDim2.new(0, 12, 0.5, 0)
        iconInner = inner
        textX = 36
    end

    local label = New("TextLabel", {
        Position = UDim2.fromOffset(textX, 0), Size = UDim2.new(1, -(textX + 6), 1, 0), Text = Tab.Name,
        Font = FONT_MED, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
    })

    function Tab:_Paint()
        local t = Claux.Theme
        local a = self.Active
        Tween(label, { TextColor3 = a and t.Text or t.SubText }, 0.12)
        if iconInner then
            if iconInner:IsA("ImageLabel") then
                Tween(iconInner, { ImageColor3 = a and t.AccentLight or t.SubText }, 0.12)
            else
                Tween(iconInner, { TextColor3 = a and t.AccentLight or t.SubText }, 0.12)
            end
        end
        Tween(btn, { BackgroundTransparency = a and 0 or 1 }, 0.12)
        Tween(bar, { BackgroundTransparency = a and 0 or 1 }, 0.12)
    end
    OnTheme(btn, function() Tab:_Paint() end)

    btn.MouseEnter:Connect(function()
        if not Tab.Active then Tween(btn, { BackgroundTransparency = 0.6 }, 0.1) end
    end)
    btn.MouseLeave:Connect(function()
        if not Tab.Active then Tween(btn, { BackgroundTransparency = 1 }, 0.1) end
    end)

    local page = New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = self.Pages,
    })
    BindTheme(page, "ScrollBarImageColor3", "Accent")
    Pad(page, 10, 12, 4, 10)
    List(page, 8)
    Tab.Page = page

    local lockOverlay = New("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.25, BackgroundColor3 = Color3.new(0, 0, 0),
        Active = true, Visible = false, ZIndex = 10, Parent = self.Pages,
    })
    local lockLabel = New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = "Locked", Font = FONT_MED, TextSize = 14, ZIndex = 11, Parent = lockOverlay })
    BindTheme(lockLabel, "TextColor3", "Text")
    Tab.LockOverlay, Tab.LockLabel = lockOverlay, lockLabel

    btn.Activated:Connect(function() self:SelectTab(Tab) end)

    table.insert(self.Tabs, Tab)
    if not self.CurrentTab then self:SelectTab(Tab) end
    return Tab
end

function WindowMethods:SelectTab(tab)
    if type(tab) == "string" then
        for _, t in ipairs(self.Tabs) do
            if t.Name == tab then
                tab = t
                break
            end
        end
    end
    if type(tab) ~= "table" or not tab.Page then return end
    Claux:_ClosePopup()
    self.CurrentTab = tab
    for _, t in ipairs(self.Tabs) do
        local active = (t == tab)
        t.Active = active
        t.Page.Visible = active and not self.Searching
        t.LockOverlay.Visible = active and t.Locked and not self.Searching
        t:_Paint()
    end
    if not self.Searching then self.PageTitle.Text = tab.Name end
end

----------------------------------------------------------------------
-- Search (Chloex-style fuzzy search, results page)
----------------------------------------------------------------------
function WindowMethods:_GoTo(entry)
    self.SearchBox.Text = ""
    self:SelectTab(entry.Tab)
    entry.Section:SetOpen(true)
    task.delay(0.08, function()
        local page = entry.Tab.Page
        if not entry.Frame.Parent then return end
        local y = entry.Frame.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y
        page.CanvasPosition = Vector2.new(0, math.max(0, y - 10))
        local s = New("UIStroke", { Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = Claux.Theme.Accent, Parent = entry.Frame })
        Tween(s, { Transparency = 1 }, 1.2)
        task.delay(1.3, function() s:Destroy() end)
    end)
end

function WindowMethods:_RunSearch(q)
    q = Trim(q)
    if q == "" then
        self.Searching = false
        self.SearchPage.Visible = false
        if self.CurrentTab then self:SelectTab(self.CurrentTab) end
        return
    end

    self.Searching = true
    Claux:_ClosePopup()
    for _, t in ipairs(self.Tabs) do
        t.Page.Visible = false
        t.LockOverlay.Visible = false
    end
    self.PageTitle.Text = "Search"

    local page = self.SearchPage
    page.Visible = true
    for _, c in ipairs(page:GetChildren()) do
        if c:IsA("GuiObject") then c:Destroy() end
    end

    local results = {}
    for _, e in ipairs(self.SearchRegistry) do
        local score = math.max(SmartMatch(q, e.Title), SmartMatch(q, e.Content) - 200, SmartMatch(q, e.Section.Title) - 400)
        if score > 0 then results[#results + 1] = { Entry = e, Score = score } end
    end
    table.sort(results, function(a, b) return a.Score > b.Score end)

    if #results == 0 then
        local none = New("TextLabel", { Size = UDim2.new(1, 0, 0, 30), Text = "Tidak ada hasil untuk \"" .. q .. "\".", TextSize = 12, LayoutOrder = 1, Parent = page })
        BindTheme(none, "TextColor3", "SubText")
        return
    end

    for i = 1, math.min(#results, 30) do
        local e = results[i].Entry
        local row = New("TextButton", { Size = UDim2.new(1, 0, 0, 40), Text = "", BackgroundTransparency = 0, LayoutOrder = i, Parent = page })
        BindTheme(row, "BackgroundColor3", "Element")
        Corner(row, 6)
        local t1 = New("TextLabel", { Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -20, 0, 16), Text = tostring(e.Title), Font = FONT_MED, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
        BindTheme(t1, "TextColor3", "Text")
        local t2 = New("TextLabel", { Position = UDim2.fromOffset(10, 22), Size = UDim2.new(1, -20, 0, 13), Text = e.Tab.Name .. "  >  " .. e.Section.Title, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
        BindTheme(t2, "TextColor3", "SubText")
        row.MouseEnter:Connect(function() Tween(row, { BackgroundColor3 = Claux.Theme.ElementHover }, 0.1) end)
        row.MouseLeave:Connect(function() Tween(row, { BackgroundColor3 = Claux.Theme.Element }, 0.1) end)
        row.Activated:Connect(function() self:_GoTo(e) end)
    end
end

function WindowMethods:FocusSearch()
    if not self.Visible then self:SetVisible(true) end
    if self.SearchBox then self.SearchBox:CaptureFocus() end
end

