        BindTheme(f, "BackgroundColor3", "Section")
        Corner(f, 6)
        Stroke(f, "Outline")
        List(f, 0)
        local head = New("TextLabel", { Size = UDim2.new(1, 0, 0, 24), Text = "Keybinds", Font = FONT_BOLD, TextSize = 12, LayoutOrder = 1, Parent = f })
        BindTheme(head, "TextColor3", "Text")
        local line = New("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 2, Parent = f })
        AccentGradient(line, 0)
        local holder = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = f })
        Pad(holder, 8, 8, 4, 6)
        List(holder, 2)
        self.KeybindFrame, self.KeybindHolder = f, holder
    end
    self:_RefreshKeybindList()
end

function Claux:_RefreshKeybindList()
    if not self.KeybindListEnabled or not self.KeybindFrame or not self.KeybindHolder then return end
    for _, c in ipairs(self.KeybindHolder:GetChildren()) do
        if c:IsA("GuiObject") then c:Destroy() end
    end
    local count = 0
    for _, kb in ipairs(self.Keybinds) do
        if kb.TitleText and not kb.Hidden and kb.Key then
            count = count + 1
            local active = (kb.Owner and kb.Owner.Value) or kb.State
            local row = New("Frame", { Size = UDim2.new(1, 0, 0, 18), LayoutOrder = count, Parent = self.KeybindHolder })
            local name = New("TextLabel", { Size = UDim2.new(1, -50, 1, 0), Text = kb.TitleText, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
            name.TextColor3 = active and self.Theme.Text or self.Theme.SubText
            local key = New("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 46, 1, 0), Text = "[" .. KeyName(kb.Key) .. "]", Font = FONT_MED, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
            key.TextColor3 = active and self.Theme.Accent or self.Theme.SubText
        end
    end
    self.KeybindFrame.Visible = count > 0
end

-- Toggles change the "active" colour in the keybind list.
local BaseChanged = Claux._Changed
function Claux:_Changed(el)
    BaseChanged(self, el)
    if el.Type == "Toggle" then self:_RefreshKeybindList() end
end

