----------------------------------------------------------------------
-- Search helpers
----------------------------------------------------------------------
local function SmartMatch(query, text)
    query = string.lower(query or "")
    text = string.lower(text or "")
    if query == "" or text == "" then return 0 end
    if text == query then return 1000 end
    local s = string.find(text, query, 1, true)
    if s then return 800 - s end
    if #query < 2 then return 0 end
    local qi, score, last = 1, 0, 0
    for i = 1, #text do
        if text:sub(i, i) == query:sub(qi, qi) then
            score = score + ((i == last + 1) and 5 or 1)
            last = i
            qi = qi + 1
            if qi > #query then return 100 + score end
        end
    end
    return 0
end

