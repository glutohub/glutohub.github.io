function Claux:Window(cfg)
    cfg = type(cfg) == "table" and cfg or {}
    EnsureGui()

    -- theme / accent
    local bgImage = cfg.Background
    if type(cfg.Theme) == "string" then
        if cfg.Theme:match("^%d+$") then
            bgImage = bgImage or cfg.Theme -- Chloex used "Theme" for a background asset id
        elseif Themes[cfg.Theme] then
            self:SetTheme(cfg.Theme)
        end
    end
    if typeof(cfg.Color) == "Color3" then self:SetAccent(cfg.Color) end

    -- config paths
    Cfg.GameName = GetGameName()
    local folder = SanitizeName(cfg.Folder)
    if folder == "" then folder = Cfg.GameName end
    SetupPaths(folder)
    Cfg.Version = cfg.Version or 1
    Cfg.VersionReset = cfg.VersionReset == true
    if cfg.AutoSave == false then Cfg.AutoSave = false end

    -- key system gate
    if cfg.KeySystem then
        if not RunKeyGate(cfg.KeySystem, folder) then return nil end
    end

    self:LoadConfigFromFile()

    local Window = setmetatable({
        Title = tostring(cfg.Title or "Claux"), Tabs = {}, SearchRegistry = {}, Visible = true, Searching = false,
        BlurEnabled = cfg.Blur ~= false, AlwaysShowLogo = cfg.AlwaysShowLogo == true,
    }, WindowMethods)
    table.insert(self.Windows, Window)

    -- sizes
    local baseW, baseH = IsMobile and 480 or 640, IsMobile and 280 or 400
    if typeof(cfg.Size) == "UDim2" then
        baseW, baseH = cfg.Size.X.Offset, cfg.Size.Y.Offset
    elseif typeof(cfg.Size) == "Vector2" then
        baseW, baseH = cfg.Size.X, cfg.Size.Y
    end
    local cam = GetCamera()
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local W, H = math.min(baseW, vp.X - 24), math.min(baseH, vp.Y - 24)
    local tabWidth = Clamp(cfg["Tab Width"] or cfg.TabWidth or (IsMobile and 110 or 140), 90, math.max(90, W - 220))
    local TOP = 40

    -- holder + shadow + main
    local Holder = New("Frame", {
        Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(W, H), Parent = self.Gui,
    })
    local UIScaleObj = New("UIScale", { Scale = 1, Parent = Holder })
    New("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 44, 1, 44),
        Image = "rbxassetid://6015897843", ImageColor3 = Color3.new(0, 0, 0), ImageTransparency = 0.5,
        ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = 0, Parent = Holder,
    })
    local Main = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.06, ZIndex = 1, ClipsDescendants = true, Parent = Holder })
    BindTheme(Main, "BackgroundColor3", "Background")
    Corner(Main, 8)
    Stroke(Main, "Outline")

    local bgRes = ResolveImage(bgImage)
    if bgRes then
        local bg = New("ImageLabel", { Size = UDim2.fromScale(1, 1), Image = bgRes, ImageTransparency = 0.85, ScaleType = Enum.ScaleType.Crop, ZIndex = 0, Parent = Main })
        Corner(bg, 8)
    end

    -- top bar (drag handle)
    local Topbar = New("TextButton", { Size = UDim2.new(1, 0, 0, TOP), Text = "", Parent = Main })
    local logo = MakeLogo(Topbar, 26, cfg.Image)
    logo.Position = UDim2.fromOffset(10, 7)

    local hasFooter = cfg.Footer and tostring(cfg.Footer) ~= ""
    local TitleLabel = New("TextLabel", {
        Position = UDim2.fromOffset(44, hasFooter and 5 or 12), Size = UDim2.new(1, -240, 0, 16), Text = Window.Title,
        Font = FONT_BOLD, TextSize = 14, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = Topbar,
    })
    AccentGradient(TitleLabel, 0)
    Window.TitleLabel = TitleLabel
    if hasFooter then
        local footer = New("TextLabel", {
            Position = UDim2.fromOffset(44, 22), Size = UDim2.new(1, -240, 0, 12), Text = tostring(cfg.Footer), TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Topbar,
        })
        BindTheme(footer, "TextColor3", "SubText")
    end

    local Controls = New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0, TOP / 2), Size = UDim2.fromOffset(0, 26),
        AutomaticSize = Enum.AutomaticSize.X, Parent = Topbar,
    })
    List(Controls, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

    -- search box
    local SearchWrap = New("Frame", { Size = UDim2.fromOffset(IsMobile and 100 or 150, 26), BackgroundTransparency = 0, LayoutOrder = 1, Parent = Controls })
    BindTheme(SearchWrap, "BackgroundColor3", "Element")
    Corner(SearchWrap, 6)
    Stroke(SearchWrap, "Outline")
    local sIcon = MakeIcon(SearchWrap, "search", 13, "SubText", "?")
    sIcon.AnchorPoint = Vector2.new(0, 0.5)
    sIcon.Position = UDim2.new(0, 8, 0.5, 0)
    local SearchBox = New("TextBox", {
        Position = UDim2.fromOffset(27, 0), Size = UDim2.new(1, -33, 1, 0), Text = "", PlaceholderText = "Search...",
        ClearTextOnFocus = false, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = SearchWrap,
    })
    BindTheme(SearchBox, "TextColor3", "Text")
    BindTheme(SearchBox, "PlaceholderColor3", "SubText")
    SearchWrap.Visible = cfg.Search ~= false
    Window.SearchBox = SearchBox

    local function IconButton(order, icon, fallback, cb)
        local b = New("TextButton", { Size = UDim2.fromOffset(26, 26), Text = "", LayoutOrder = order, Parent = Controls })
        BindTheme(b, "BackgroundColor3", "Element")
        Corner(b, 6)
        local holder = MakeIcon(b, icon, 15, "SubText", fallback)
        holder.AnchorPoint = Vector2.new(0.5, 0.5)
        holder.Position = UDim2.fromScale(0.5, 0.5)
