local function JoinDiscord(link)
    link = tostring(link or "")
    local code = link:match("discord%.gg/([%w%-_]+)") or link:match("discord%.com/invite/([%w%-_]+)") or link
    local url = "https://discord.gg/" .. code
    local copied = SetClipboard(url)
    local req = (syn and syn.request) or request or http_request
    if req then
        pcall(function()
            req({
                Url = "http://127.0.0.1:6463/rpc?v=1", Method = "POST",
                Headers = { ["Content-Type"] = "application/json", Origin = "https://discord.com" },
                Body = HttpService:JSONEncode({ cmd = "INVITE_BROWSER", args = { code = code }, nonce = HttpService:GenerateGUID(false) }),
            })
        end)
    end
    Claux:Notify({ Title = "Discord", Content = copied and "Link invite disalin ke clipboard." or url, Type = "Success" })
end

----------------------------------------------------------------------
-- Key system gate (from Chloex, restyled)
----------------------------------------------------------------------
local function RunKeyGate(KeyConfig, Scope)
    KeyConfig = type(KeyConfig) == "table" and KeyConfig or {}
    local saveKey = KeyConfig.SaveKey ~= false
    local scope = SanitizeName(Scope)
    local fileName = KeyConfig.FileName or ("Claux/Config/" .. (scope ~= "" and (scope .. "_key.txt") or "key.txt"))

    local function IsValid(key)
        if key == "" then return false end
        if type(KeyConfig.Validate) == "function" then
            local ok, res = pcall(KeyConfig.Validate, key)
            return ok and res == true
        end
        if type(KeyConfig.Keys) == "table" then
            for _, k in ipairs(KeyConfig.Keys) do
                if tostring(k) == key then return true end
            end
        end
        return false
    end

    if saveKey then
        local saved = SafeRead(fileName)
        if saved and IsValid(Trim(saved)) then return true end
    end

    local gui = EnsureGui()
    local result
    local overlay = New("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.4,
        BackgroundColor3 = Color3.new(0, 0, 0), Active = true, ZIndex = 300, Parent = gui,
    })
    local card = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(340, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 0, Parent = overlay,
    })
    BindTheme(card, "BackgroundColor3", "Background")
    Corner(card, 10)
    Stroke(card, "Outline")

    local inner = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
    Pad(inner, 16, 16, 14, 16)
    List(inner, 10)

    local title = New("TextLabel", {
        Size = UDim2.new(1, -30, 0, 22), Text = KeyConfig.Title or "Claux", Font = FONT_BOLD, TextSize = 17,
        TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = inner,
    })
    AccentGradient(title, 0)

    local note = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
        Text = KeyConfig.Note or "Masukkan key kamu di bawah ini untuk melanjutkan.",
        TextXAlignment = Enum.TextXAlignment.Left, TextSize = 12, LayoutOrder = 2, Parent = inner,
    })
    BindTheme(note, "TextColor3", "SubText")

    local box = New("TextBox", {
        Size = UDim2.new(1, 0, 0, 32), Text = "", PlaceholderText = "Enter key...", ClearTextOnFocus = false,
        TextSize = 12, BackgroundTransparency = 0, LayoutOrder = 3, Parent = inner,
    })
    BindTheme(box, "BackgroundColor3", "Element")
    BindTheme(box, "TextColor3", "Text")
    BindTheme(box, "PlaceholderColor3", "SubText")
    Corner(box, 6)
    Stroke(box, "Outline")
    Pad(box, 10, 10, 0, 0)

    local status = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14), Text = "", TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 4, Parent = inner,
    })
    local function SetStatus(text, key)
        status.Text = text
        status.TextColor3 = Claux.Theme[key or "SubText"]
    end

    local row = New("Frame", { Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 5, Parent = inner })
    List(row, 8, Enum.FillDirection.Horizontal)

    local link = KeyConfig.Link or KeyConfig.GetKeyLink or KeyConfig.Url
    local submit = New("TextButton", {
        Size = UDim2.new(link and 0.5 or 1, link and -4 or 0, 1, 0), Text = "Submit", Font = FONT_MED, TextSize = 13,
        TextColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1),
        LayoutOrder = 1, Parent = row,
    })
    Corner(submit, 6)
    AccentGradient(submit, 0)

    if link then
        local get = New("TextButton", {
            Size = UDim2.new(0.5, -4, 1, 0), Text = "Get Key", Font = FONT_MED, TextSize = 13,
            BackgroundTransparency = 0, LayoutOrder = 2, Parent = row,
        })
        BindTheme(get, "BackgroundColor3", "Element")
        BindTheme(get, "TextColor3", "Text")
        Corner(get, 6)
        Stroke(get, "Outline")
        get.Activated:Connect(function()
            local ok = SetClipboard(tostring(link))
            SetStatus(ok and "Link key disalin ke clipboard." or tostring(link), "Success")
        end)
    end

    local closeBtn = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(24, 24),
        Text = "x", Font = FONT_BOLD, TextSize = 14, Parent = card,
    })
    BindTheme(closeBtn, "TextColor3", "SubText")
    closeBtn.Activated:Connect(function() result = false end)

    local busy = false
    local function Submit()
        if busy then return end
        local key = Trim(box.Text)
        if key == "" then
            SetStatus("Key tidak boleh kosong.", "Warning")
            return
        end
        busy = true
        SetStatus("Memeriksa key...", "SubText")
        task.spawn(function()
            if IsValid(key) then
                if saveKey then SafeWrite(fileName, key) end
                SetStatus("Key valid!", "Success")
                task.wait(0.35)
                result = true
            else
                SetStatus("Key tidak valid.", "Danger")
                busy = false
            end
        end)
    end
    submit.Activated:Connect(Submit)
    box.FocusLost:Connect(function(enter) if enter then Submit() end end)

    while result == nil do
        if not overlay.Parent then result = false break end
        task.wait(0.1)
    end
    overlay:Destroy()
    return result == true
end

----------------------------------------------------------------------
-- Config system (Chloex ConfigData/Elements + Neverlose Flags)
----------------------------------------------------------------------
local Cfg = {
    Version = 1, VersionReset = false, Applying = false, SaveQueued = false, AutoSave = true,
    ActiveName = nil, Folder = "Default", File = nil, Dir = nil, AutoloadFile = nil, GameName = "Unknown",
}

local InternalKeys = {
    _version = true, _meta = true, Game = true, Version = true, PlaceId = true,
    Hub = true, SavedAt = true, ActiveConfig = true, AutoLoad = true,
}

local function SetupPaths(folder)
    local f = SanitizeName(folder)
    if f == "" then f = "Default" end
    Cfg.Folder = f
    Cfg.File = "Claux/Config/" .. f .. ".json"
    Cfg.Dir = "Claux/Configs/" .. f
    Cfg.AutoloadFile = Cfg.Dir .. "/_autoload.txt"
end

local function GetGameName()
    local id = game.PlaceId
    local cache = "Claux/GameName_" .. tostring(id) .. ".txt"
    local cached = SafeRead(cache)
    if cached then return cached end
    local ok, info = pcall(function() return MarketplaceService:GetProductInfo(id) end)
    local name = ""
    if ok and info and info.Name then name = SanitizeName(info.Name) end
    if name == "" then name = "Place_" .. tostring(id) else SafeWrite(cache, name) end
    return name
end

local function BuildPayload()
    return {
        _meta = { Hub = "Claux", Game = Cfg.GameName, PlaceId = game.PlaceId, Version = Cfg.Version, SavedAt = os.time(), ActiveConfig = Cfg.ActiveName },
        Data = Claux:GetConfigSnapshot(),
    }
end

local function ExtractData(payload)
    if type(payload) ~= "table" then return nil end
    local data = payload
    if type(payload.Data) == "table" then data = payload.Data
    elseif type(payload.Config) == "table" then data = payload.Config
    elseif type(payload.Settings) == "table" then data = payload.Settings end
    local cleaned = {}
    for k, v in pairs(data) do
        if type(k) == "string" and k:sub(1, 1) ~= "_" and not InternalKeys[k] then cleaned[k] = v end
    end
    return cleaned
end

-- ConfigData (values loaded from disk, including elements not created yet)
-- overlaid with the live value of every saveable element.
function Claux:GetConfigSnapshot()
    local data = CopyTable(self.ConfigData)
    for key, el in pairs(self.Elements) do
        if el._Save and el._Export then
            local ok, v = pcall(el._Export, el)
            if ok and v ~= nil then data[key] = v end
        end
    end
    return data
end

function Claux:_Changed(el)
    if not el.Flag then return end
    self.Flags[el.Flag] = el:Get()
    if el._Save and not Cfg.Applying then
        self.ConfigData[el.Flag] = el:_Export()
        self:QueueSave()
    end
end

function Claux:QueueSave(force)
    if not Cfg.AutoSave and not force then return end
    if Cfg.Applying and not force then return end
    if Cfg.SaveQueued then return end
    Cfg.SaveQueued = true
    task.delay(0.6, function()
        Cfg.SaveQueued = false
        self:SaveConfig(true)
    end)
end

function Claux:SaveConfig(force)
    if not HasFS or not Cfg.File then return false end
    if Cfg.Applying and not force then return false end
    return SafeWrite(Cfg.File, JSONEncode(BuildPayload()))
end

function Claux:LoadConfigFromFile()
    local raw = SafeRead(Cfg.File)
    if not raw then return false end
    local payload = SafeJSONDecode(raw)
    if type(payload) ~= "table" then return false end
    local meta = payload._meta
    if Cfg.VersionReset and type(meta) == "table" and meta.Version ~= nil and meta.Version ~= Cfg.Version then return false end
    local data = ExtractData(payload)
    if not data then return false end
    for k, v in pairs(data) do self.ConfigData[k] = v end
    if type(meta) == "table" and type(meta.ActiveConfig) == "string" then Cfg.ActiveName = meta.ActiveConfig end
    return true
end

-- Apply a data table to the live elements (callbacks are fired so features update).
function Claux:ApplyConfigData(data)
    Cfg.Applying = true
    for k, v in pairs(data) do self.ConfigData[k] = v end
    -- Theme first, so a saved accent colour is applied on top of it.
    local keys = {}
    for key in pairs(data) do table.insert(keys, key) end
    table.sort(keys, function(a, b)
        local ta, tb = (a == "Claux_Theme"), (b == "Claux_Theme")
        if ta ~= tb then return ta end
        return tostring(a) < tostring(b)
    end)
    for _, key in ipairs(keys) do
        local value = data[key]
        local el = self.Elements[key]
        if el and el._Import then
            local ok, err = pcall(el._Import, el, value)
            if ok then
                if el._Fire then pcall(el._Fire, el) end
            else
                warn("[Claux] Gagal apply '" .. tostring(key) .. "': " .. tostring(err))
            end
        end
    end
    Cfg.Applying = false
end

local function ReadIndex()
    local raw = SafeRead(Cfg.Dir .. "/_index.json")
    local t = raw and SafeJSONDecode(raw)
    return type(t) == "table" and t or {}
end

local function IndexAdd(name)
    local list = ReadIndex()
    if not table.find(list, name) then
        table.insert(list, name)
        SafeWrite(Cfg.Dir .. "/_index.json", JSONEncode(list))
    end
end

local function IndexRemove(name)
    local list = ReadIndex()
    local idx = table.find(list, name)
    if idx then
        table.remove(list, idx)
        SafeWrite(Cfg.Dir .. "/_index.json", JSONEncode(list))
    end
end

function Claux:GetConfigs()
    local set, list = {}, {}
    if not HasFS or not Cfg.Dir then return list end
    EnsureFolder(Cfg.Dir)
    if type(listfiles) == "function" then
        local ok, files = pcall(listfiles, Cfg.Dir)
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local name = tostring(path):match("([^/\\]+)%.json$")
                if name and name ~= "_index" then set[name] = true end
            end
        end
    end
    for _, name in ipairs(ReadIndex()) do
        if type(name) == "string" and isfile(Cfg.Dir .. "/" .. name .. ".json") then set[name] = true end
    end
    for name in pairs(set) do table.insert(list, name) end
    table.sort(list)
    return list
end

function Claux:SaveConfigAs(name)
    name = SanitizeName(name)
    if name == "" then return false, "Nama config kosong." end
    if not HasFS then return false, "Executor tidak mendukung file system." end
    Cfg.ActiveName = name
    local ok = SafeWrite(Cfg.Dir .. "/" .. name .. ".json", JSONEncode(BuildPayload()))
    if not ok then return false, "Gagal menulis file." end
    IndexAdd(name)
    self:QueueSave(true)
    return true
end

function Claux:LoadConfigByName(name)
    name = SanitizeName(name)
    if name == "" then return false, "Nama config kosong." end
    local raw = SafeRead(Cfg.Dir .. "/" .. name .. ".json")
    if not raw then return false, "Config tidak ditemukan." end
    local data = ExtractData(SafeJSONDecode(raw))
    if not data then return false, "Config rusak." end
    self:ApplyConfigData(data)
    Cfg.ActiveName = name
    self:QueueSave(true)
    return true
end

function Claux:DeleteConfig(name)
    name = SanitizeName(name)
    local path = Cfg.Dir .. "/" .. name .. ".json"
    if name == "" or not HasFS or not isfile(path) then return false end
    if type(delfile) == "function" then pcall(delfile, path) end
    IndexRemove(name)
    if self:GetAutoLoad() == name then self:SetAutoLoad("") end
    if Cfg.ActiveName == name then Cfg.ActiveName = nil end
    return true
end

function Claux:SetAutoLoad(name)
    if not HasFS then return false end
    return SafeWrite(Cfg.AutoloadFile, SanitizeName(name))
end

function Claux:GetAutoLoad()
    local raw = SafeRead(Cfg.AutoloadFile)
    return raw and Trim(raw) or ""
end

function Claux:ExportConfig()
    return "CLAUX:" .. B64Encode(JSONEncode(BuildPayload()))
end

function Claux:ImportConfig(str)
    str = Trim(str)
    if str == "" then return false, "String kosong." end
    local json = str
    if str:sub(1, 6) == "CLAUX:" then json = B64Decode(str:sub(7)) end
    local data = ExtractData(SafeJSONDecode(json))
    if not data then return false, "Format config tidak valid." end
    self:ApplyConfigData(data)
    self:QueueSave(true)
    return true
end

----------------------------------------------------------------------
-- Element plumbing: locks, flags, registration
----------------------------------------------------------------------
local function AttachLock(frame, radius)
    local overlay = New("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.3, BackgroundColor3 = Color3.new(0, 0, 0),
        Active = true, Visible = false, ZIndex = 20, Parent = frame,
    })
    Corner(overlay, radius or 6)
    local label = New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = "Locked", Font = FONT_MED, TextSize = 12, ZIndex = 21, Parent = overlay })
    BindTheme(label, "TextColor3", "Text")
    local api = {}
    function api:Lock(text)
        if text then label.Text = tostring(text) end
        overlay.Visible = true
    end
    function api:Unlock() overlay.Visible = false end
    return api
end

local function SyncFlag(el)
    if el.Flag then Claux.Flags[el.Flag] = el:Get() end
end

-- Assign a unique flag, load the saved value (if any) and expose the element.
local function RegisterElement(kind, cfg, el)
    local title = cfg.Title or cfg.Name or kind
    local base = cfg.Flag or (kind .. "_" .. tostring(title))
    local key, n = base, 1
    while Claux.Elements[key] do
        n = n + 1
        key = base .. "_" .. n
    end
    el.Flag = key
    el._Save = cfg.Save ~= false
    Claux.Elements[key] = el
    if el._Save then
        local saved = Claux.ConfigData[key]
        if saved ~= nil and el._Import then pcall(el._Import, el, saved) end
    end
    SyncFlag(el)
    return key
end

----------------------------------------------------------------------
-- Row builder (every item lives in one of these cards)
----------------------------------------------------------------------
local function MakeRow(section, cfg, opts)
    opts = opts or {}
    local title = cfg.Title or cfg.Name or ""
    local content = cfg.Content or cfg.Description or ""
    local minH = opts.MinHeight or 34

    local Frame = New("Frame", {
        Size = UDim2.new(1, 0, 0, minH), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 0, LayoutOrder = section:_NextOrder(), Parent = section.Body,
    })
    BindTheme(Frame, "BackgroundColor3", "Element")
    Corner(Frame, 6)

    local Inner = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = Frame })
    List(Inner, 0)

    local Head = New("Frame", { Size = UDim2.new(1, 0, 0, minH), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = Inner })

    local Left = New("Frame", { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 1, Parent = Head })
    Pad(Left, 0, 0, 9, 9)
    List(Left, 1)

    local Title = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = title, Font = FONT_MED, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Visible = title ~= "", LayoutOrder = 1, Parent = Left,
    })
    BindTheme(Title, "TextColor3", "Text")

    local Content = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = content, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
        Visible = content ~= "", LayoutOrder = 2, Parent = Left,
    })
    BindTheme(Content, "TextColor3", "SubText")

    local Hit, Right
    if not opts.NoInteract then
        Hit = New("TextButton", { Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 2, Parent = Head })
        Hit.MouseEnter:Connect(function() Tween(Frame, { BackgroundColor3 = Claux.Theme.ElementHover }, 0.12) end)
        Hit.MouseLeave:Connect(function() Tween(Frame, { BackgroundColor3 = Claux.Theme.Element }, 0.12) end)
    end
    if not opts.NoRight then
        Right = New("Frame", {
            AnchorPoint = Vector2.new(1, opts.RightTop and 0 or 0.5),
            Position = opts.RightTop and UDim2.new(1, -8, 0, 7) or UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 3, Parent = Head,
        })
        List(Right, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
        local function Fit() Left.Size = UDim2.new(1, -(Right.AbsoluteSize.X + 28), 0, 0) end
        Right:GetPropertyChangedSignal("AbsoluteSize"):Connect(Fit)
        Fit()
    end

    return { Frame = Frame, Inner = Inner, Head = Head, Left = Left, Right = Right, Hit = Hit, Title = Title, Content = Content }
end

-- Shared methods for every row-based element + search registration.
local function Decorate(section, El, R, cfg)
    El.Frame = R.Frame
    El.Row = R
    El.Section = section
    El.TitleText = cfg.Title or cfg.Name or ""

    local lock = AttachLock(R.Frame, 6)
    function El:Lock(text) lock:Lock(text) end
    function El:Unlock() lock:Unlock() end
    function El:SetVisible(v) R.Frame.Visible = v and true or false end
    function El:SetTitle(t)
        t = tostring(t or "")
        R.Title.Text = t
        R.Title.Visible = t ~= ""
        self.TitleText = t
    end
    function El:SetContent(t)
        t = tostring(t or "")
        R.Content.Text = t
        R.Content.Visible = t ~= ""
    end

    local entry = { Title = El.TitleText, Content = cfg.Content or cfg.Description or "", Tab = section.Tab, Section = section, Frame = R.Frame }
    table.insert(section.Window.SearchRegistry, entry)

    function El:Destroy()
        local idx = table.find(section.Window.SearchRegistry, entry)
        if idx then table.remove(section.Window.SearchRegistry, idx) end
        if self.Flag then
            Claux.Elements[self.Flag] = nil
            Claux.Flags[self.Flag] = nil
        end
        local kb = table.find(Claux.Keybinds, self)
        if kb then table.remove(Claux.Keybinds, kb) end
        R.Frame:Destroy()
    end
end

local function Finish(section, El, R, cfg, kind, opts)
    opts = opts or {}
    Decorate(section, El, R, cfg)
    if not opts.NoRegister then RegisterElement(kind, cfg, El) end
    if opts.Fire then
        task.defer(function()
            if El._Fire then El:_Fire() end
        end)
    end
    return El
end

----------------------------------------------------------------------
-- Keybind widget (standalone row or chip on a toggle row)
----------------------------------------------------------------------
local ModeCycle = { "Press", "Toggle", "Hold" }
local KeyShort = {
    LeftControl = "LCtrl", RightControl = "RCtrl", LeftShift = "LShift", RightShift = "RShift",
    LeftAlt = "LAlt", RightAlt = "RAlt", Backspace = "Bksp", Return = "Enter", Insert = "Ins",
    Delete = "Del", PageUp = "PgUp", PageDown = "PgDn", CapsLock = "Caps", Escape = "Esc", Backquote = "`",
}

local function KeyName(kc)
    if not kc then return "None" end
    return KeyShort[kc.Name] or kc.Name
end

local function ParseKey(v)
    if typeof(v) == "EnumItem" then return v end
    if type(v) == "string" and v ~= "" and v ~= "None" then
        local ok, kc = pcall(function() return Enum.KeyCode[v] end)
        if ok then return kc end
    end
    return nil
end

local function MakeKeybind(container, cfg, owner, layoutOrder)
    local modes = cfg.Modes or (owner and { "Toggle", "Hold" } or ModeCycle)
    local El = { Type = "Keybind", Key = ParseKey(cfg.Default), State = false, Hidden = cfg.HideInList == true }
    El.Mode = cfg.Mode or modes[1]
    if not table.find(modes, El.Mode) then El.Mode = modes[1] end
    El.TitleText = cfg.Title or cfg.Name or (owner and ((owner.TitleText or "Toggle") .. " Key")) or "Keybind"
    El.Owner = owner

    local chip = New("TextButton", {
        Size = UDim2.fromOffset(34, 20), AutomaticSize = Enum.AutomaticSize.X, Text = KeyName(El.Key),
        Font = FONT_MED, TextSize = 11, BackgroundTransparency = 0, LayoutOrder = layoutOrder or 1, Parent = container,
    })
    BindTheme(chip, "BackgroundColor3", "Background")
    BindTheme(chip, "TextColor3", "SubText")
    Corner(chip, 5)
    Stroke(chip, "Outline")
    Pad(chip, 8, 8, 0, 0)
    El.Chip = chip

    local function Refresh()
        chip.Text = (Claux.Listening == El) and "..." or KeyName(El.Key)
        if Claux._RefreshKeybindList then Claux:_RefreshKeybindList() end
    end
    El._Refresh = Refresh

    function El:Get() return { Key = self.Key, Mode = self.Mode, Active = owner and owner.Value or self.State } end

    function El:SetKey(kc, silent)
        self.Key = kc
        Refresh()
        SyncFlag(self)
        Fire(cfg.OnChanged, kc)
        if not silent then Claux:_Changed(self) end
    end
    function El:Set(v, silent) self:SetKey(ParseKey(v), silent) end

    function El:SetMode(m, silent)
        if not table.find(modes, m) then return end
        self.Mode = m
        Refresh()
        SyncFlag(self)
        if not silent then Claux:_Changed(self) end
    end

    function El:_Fire() end
    function El:_Export() return { Key = self.Key and self.Key.Name or "", Mode = self.Mode } end
    function El:_Import(v)
        if type(v) == "table" then
            if v.Mode then self:SetMode(v.Mode, true) end
            self:SetKey(ParseKey(v.Key), true)
        elseif type(v) == "string" then
            self:SetKey(ParseKey(v), true)
        end
    end

    local function Trigger(state)
        El.State = state
        if owner then owner:Set(state) end
        Fire(cfg.Callback, state)
        Refresh()
    end

    function El:_Press(code)
        if not self.Key or code ~= self.Key then return end
        if self.Mode == "Hold" then
            Trigger(true)
        elseif self.Mode == "Toggle" then
            if owner then Trigger(not owner.Value) else Trigger(not self.State) end
        else
            if owner then
                Trigger(not owner.Value)
            else
                Fire(cfg.Callback, self.Key)
                Tween(chip, { BackgroundColor3 = Claux.Theme.Accent }, 0.08)
                task.delay(0.12, function()
                    if chip.Parent then Tween(chip, { BackgroundColor3 = Claux.Theme.Background }, 0.2) end
                end)
            end
        end
    end

    function El:_Release(code)
        if self.Mode == "Hold" and self.Key and code == self.Key then Trigger(false) end
    end

    function El:BeginListen()
        local prev = Claux.Listening
        if prev == El then
            Claux.Listening = nil
        else
            Claux.Listening = El
        end
        if prev and prev._Refresh then prev._Refresh() end
        Refresh()
    end

    chip.Activated:Connect(function() El:BeginListen() end)
    chip.MouseButton2Click:Connect(function()
        if #modes <= 1 then return end
        local i = table.find(modes, El.Mode) or 1
        El:SetMode(modes[(i % #modes) + 1])
        Claux:Notify({ Title = El.TitleText, Content = "Mode: " .. El.Mode, Duration = 1.5 })
    end)

    table.insert(Claux.Keybinds, El)
    return El
end

----------------------------------------------------------------------
-- Colour picker widget (SV square + hue bar + optional alpha + hex)
----------------------------------------------------------------------
local function ColorToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function HexToColor(s)
    s = tostring(s or ""):gsub("#", ""):gsub("%s", "")
    if #s == 3 then s = s:sub(1, 1):rep(2) .. s:sub(2, 2):rep(2) .. s:sub(3, 3):rep(2) end
    if #s ~= 6 then return nil end
    local r, g, b = tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16)
    if r and g and b then return RGB(r, g, b) end
    return nil
end

local function MakeColorPicker(container, cfg, layoutOrder)
    local useAlpha = cfg.Alpha ~= nil or cfg.AllowAlpha == true
    local start = cfg.Default or cfg.Color or RGB(255, 255, 255)
    local El = { Type = "ColorPicker", Value = start, Alpha = cfg.Alpha or 1 }
    local h, s, v = start:ToHSV()

    local chip = New("TextButton", {
        Size = UDim2.fromOffset(30, 16), Text = "", BackgroundTransparency = 0, BackgroundColor3 = start,
        LayoutOrder = layoutOrder or 5, Parent = container,
    })
    Corner(chip, 4)
    Stroke(chip, "Outline")
    El.Chip = chip

    local Pop, SV, SVCursor, HueCursor, AlphaBar, AlphaCursor, Hex

    local function Visual()
        if not Pop then return end
        SV.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        SVCursor.Position = UDim2.fromScale(s, 1 - v)
        HueCursor.Position = UDim2.fromScale(h, 0.5)
        if AlphaBar then
            AlphaBar.BackgroundColor3 = El.Value
            AlphaCursor.Position = UDim2.fromScale(El.Alpha, 0.5)
        end
        Hex.Text = ColorToHex(El.Value)
    end

    local function Apply(silent)
        El.Value = Color3.fromHSV(h, s, v)
        chip.BackgroundColor3 = El.Value
        Visual()
        SyncFlag(El)
        if not silent then
            Claux:_Changed(El)
            El:_Fire()
        end
    end

    local function Build()
        Pop = New("Frame", { Visible = false, BackgroundTransparency = 0, ZIndex = 2, Parent = Claux.PopupLayer })
        BindTheme(Pop, "BackgroundColor3", "Background")
        Corner(Pop, 8)
        Stroke(Pop, "Outline")

        SV = New("TextButton", { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 100), Text = "", BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 0, 0), Parent = Pop })
        Corner(SV, 4)
        local white = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = SV })
        Corner(white, 4)
        New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
        local black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(0, 0, 0), Parent = SV })
        Corner(black, 4)
        New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
        SVCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(9, 9), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = SV })
        Corner(SVCursor, 5)
        New("UIStroke", { Thickness = 1.5, Color = Color3.new(0, 0, 0), Parent = SVCursor })

        local hueBar = New("TextButton", { Position = UDim2.fromOffset(8, 116), Size = UDim2.new(1, -16, 0, 10), Text = "", BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = Pop })
        Corner(hueBar, 5)
        local kps = {}
        for i = 0, 6 do
            table.insert(kps, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.999), 1, 1)))
        end
        New("UIGradient", { Color = ColorSequence.new(kps), Parent = hueBar })
        HueCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 14), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = hueBar })
        Corner(HueCursor, 2)
        New("UIStroke", { Thickness = 1, Color = Color3.new(0, 0, 0), Parent = HueCursor })

        local hexY = 132
        if useAlpha then
            AlphaBar = New("TextButton", { Position = UDim2.fromOffset(8, 132), Size = UDim2.new(1, -16, 0, 10), Text = "", BackgroundTransparency = 0, BackgroundColor3 = El.Value, Parent = Pop })
            Corner(AlphaBar, 5)
            New("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = AlphaBar })
            New("UIStroke", { Thickness = 1, Color = Claux.Theme.Outline, Parent = AlphaBar })
            AlphaCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 14), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = AlphaBar })
            Corner(AlphaCursor, 2)
            New("UIStroke", { Thickness = 1, Color = Color3.new(0, 0, 0), Parent = AlphaCursor })
            hexY = 148
            Draggable(AlphaBar, function(pos)
                El.Alpha = Clamp((pos.X - AlphaBar.AbsolutePosition.X) / math.max(AlphaBar.AbsoluteSize.X, 1), 0, 1)
                Apply()
            end)
        end

        Hex = New("TextBox", { Position = UDim2.fromOffset(8, hexY), Size = UDim2.new(1, -16, 0, 22), Text = "", ClearTextOnFocus = false, TextSize = 11, Font = FONT_MED, BackgroundTransparency = 0, Parent = Pop })
        BindTheme(Hex, "BackgroundColor3", "Element")
        BindTheme(Hex, "TextColor3", "Text")
        Corner(Hex, 5)
        Hex.FocusLost:Connect(function()
            local c = HexToColor(Hex.Text)
            if c then
                h, s, v = c:ToHSV()
                Apply()
            else
                Visual()
            end
        end)

        Draggable(SV, function(pos)
            s = Clamp((pos.X - SV.AbsolutePosition.X) / math.max(SV.AbsoluteSize.X, 1), 0, 1)
            v = 1 - Clamp((pos.Y - SV.AbsolutePosition.Y) / math.max(SV.AbsoluteSize.Y, 1), 0, 1)
            Apply()
        end)
        Draggable(hueBar, function(pos)
            h = Clamp((pos.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 0.999)
            Apply()
        end)
        El._PopHeight = hexY + 22 + 8
    end

    function El:Open()
        if not Pop then Build() end
        Visual()
        Claux:_OpenPopup(chip, Pop, 200, El._PopHeight)
    end
    chip.Activated:Connect(function() El:Open() end)

    function El:Get() return self.Value end
    function El:Set(color, alpha, silent)
        if type(alpha) == "boolean" then
            silent = alpha
            alpha = nil
        end
        if typeof(color) == "Color3" then h, s, v = color:ToHSV() end
        if type(alpha) == "number" then self.Alpha = Clamp(alpha, 0, 1) end
        Apply(silent)
    end
    function El:_Fire() Fire(cfg.Callback, self.Value, self.Alpha) end
    function El:_Export() return { Hex = ColorToHex(self.Value), A = self.Alpha } end
    function El:_Import(t)
        local c, a
        if type(t) == "table" then
            c = HexToColor(t.Hex)
            a = t.A
        elseif type(t) == "string" then
            c = HexToColor(t)
        end
        if c then self:Set(c, a, true) end
    end

    return El
end

