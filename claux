function WindowMethods:InfoTab(icfg)
    icfg = icfg or {}
    local Tab = self:AddTab({ Name = icfg.Name or "Info", Icon = icfg.Icon or "info" })
    local About = Tab:AddSection("About", true)
    About:AddParagraph({ Title = icfg.Title or self.Title, Content = icfg.Content or icfg.Description or ("Dibuat dengan Claux UI v" .. Claux.Version) })
    if icfg.Discord and tostring(icfg.Discord) ~= "" then
        About:AddButton({ Title = "Discord", Content = "Salin / buka link invite", Text = "Join", Callback = function() JoinDiscord(icfg.Discord) end })
    end

    local Session = Tab:AddSection("Session", true)
    Session:AddParagraph({ Title = "Player", Content = LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")" })
    Session:AddParagraph({ Title = "Game", Content = Cfg.GameName .. "  |  PlaceId " .. tostring(game.PlaceId) })
    local ok, exName, exVer = pcall(function() return identifyexecutor() end)
    if ok and exName then
        Session:AddParagraph({ Title = "Executor", Content = tostring(exName) .. (exVer and (" " .. tostring(exVer)) or "") })
    end
    Session:AddParagraph({ Title = "Config", Content = HasFS and (Cfg.File or "-") or "Executor tidak mendukung file system." })
    return Tab
end

function WindowMethods:AddSettingsTab()
    if self.SettingsTab then return self.SettingsTab end
    local Window = self
    local Tab = self:AddTab({ Name = "Settings", Icon = "settings", Order = 9999 })
    self.SettingsTab = Tab

    -- Configs ---------------------------------------------------------
    local C = Tab:AddSection("Configs")
    local selected
    local dd = C:AddDropdown({
        Title = "Config", Content = "Pilih config yang tersimpan", Options = Claux:GetConfigs(), Search = true, Save = false,
        Callback = function(v) selected = v end,
    })
    local nameBox = C:AddInput({ Title = "Config Name", Content = "Nama untuk config baru", Placeholder = "my-config", Save = false })
    local autoInfo = C:AddParagraph({ Title = "Auto Load", Content = "-" })

    local function RefreshList() dd:Refresh(Claux:GetConfigs()) end
    local function UpdateAuto()
        local a = Claux:GetAutoLoad()
        autoInfo:SetContent(a ~= "" and a or "None")
    end
    UpdateAuto()

    local function Need()
        if selected and selected ~= "" then return true end
        Claux:Notify({ Title = "Config", Content = "Pilih config dulu.", Type = "Warning" })
        return false
    end

    C:AddButton({ Title = "Create Config", Text = "Create", Callback = function()
        local name = SanitizeName(nameBox:Get())
        local ok, err = Claux:SaveConfigAs(name)
        if ok then
            Claux:Notify({ Title = "Config", Content = "Config '" .. name .. "' dibuat.", Type = "Success" })
            RefreshList()
            dd:Set(name)
        else
            Claux:Notify({ Title = "Config", Content = tostring(err), Type = "Error" })
        end
    end })
    C:AddButton({ Title = "Load Config", Text = "Load", Callback = function()
        if not Need() then return end
        local ok, err = Claux:LoadConfigByName(selected)
        Claux:Notify({ Title = "Config", Content = ok and ("Loaded '" .. selected .. "'.") or tostring(err), Type = ok and "Success" or "Error" })
    end })
    C:AddButton({ Title = "Overwrite Config", Text = "Save", Callback = function()
        if not Need() then return end
        local ok, err = Claux:SaveConfigAs(selected)
        Claux:Notify({ Title = "Config", Content = ok and ("Saved '" .. selected .. "'.") or tostring(err), Type = ok and "Success" or "Error" })
    end })
    C:AddButton({ Title = "Delete Config", Text = "Delete", Callback = function()
        if not Need() then return end
        local name = selected
        if Claux:DeleteConfig(name) then
            Claux:Notify({ Title = "Config", Content = "Deleted '" .. name .. "'.", Type = "Success" })
            selected = nil
            RefreshList()
            dd:Set(nil, true)
            UpdateAuto()
        else
            Claux:Notify({ Title = "Config", Content = "Gagal menghapus config.", Type = "Error" })
        end
    end })
    C:AddButton({ Title = "Set Auto Load", Text = "Set", Callback = function()
        if not Need() then return end
        Claux:SetAutoLoad(selected)
        UpdateAuto()
        Claux:Notify({ Title = "Config", Content = "Auto load: " .. selected, Type = "Success" })
    end })
    C:AddButton({ Title = "Clear Auto Load", Text = "Clear", Callback = function()
        Claux:SetAutoLoad("")
        UpdateAuto()
    end })
    C:AddButton({ Title = "Refresh List", Text = "Refresh", Callback = RefreshList })
    C:AddButton({ Title = "Export Config", Content = "Salin config saat ini ke clipboard", Text = "Copy", Callback = function()
        local ok = SetClipboard(Claux:ExportConfig())
        Claux:Notify({ Title = "Config", Content = ok and "Config disalin ke clipboard." or "Clipboard tidak didukung.", Type = ok and "Success" or "Error" })
    end })
    C:AddPanel({ Title = "Import Config", Content = "Tempel string CLAUX:...", Placeholder = "CLAUX:...", ButtonText = "Import", ClearOnPress = true, Callback = function(text)
        local ok, err = Claux:ImportConfig(text)
        Claux:Notify({ Title = "Config", Content = ok and "Config di-import." or tostring(err), Type = ok and "Success" or "Error" })
    end })

    -- Interface -------------------------------------------------------
    local I = Tab:AddSection("Interface")
    local initializing = true
    local hasSavedAccent = Claux.ConfigData["Claux_Accent"] ~= nil
    local accent

    I:AddKeybind({
        Title = "Menu Key", Content = "Tombol untuk buka/tutup UI", Default = self.MenuBind.Key, Modes = { "Press" },
        HideInList = true, Flag = "Claux_MenuKey", OnChanged = function(kc) Window.MenuBind.Key = kc end,
    })
    I:AddDropdown({
        Title = "Theme", Options = Claux:GetThemes(), Default = Claux.ThemeName, Flag = "Claux_Theme",
        Callback = function(name)
            if not name or name == Claux.ThemeName then return end
            if Claux:SetTheme(name) and accent and not initializing and not Cfg.Applying then
                accent:Set(Claux.Theme.Accent)
            end
        end,
    })
    accent = I:AddColorPicker({
        Title = "Accent Color", Default = Claux.Theme.Accent, Flag = "Claux_Accent",
        Callback = function(c)
            if initializing and not hasSavedAccent then return end
            if c ~= Claux.Theme.Accent then Claux:SetAccent(c) end
        end,
    })
    task.defer(function() initializing = false end)

    I:AddSlider({
        Title = "Window Opacity", Min = 40, Max = 100, Default = 94, Suffix = "%", Flag = "Claux_Opacity",
        Callback = function(v) Window.Main.BackgroundTransparency = 1 - (v / 100) end,
    })
    I:AddToggle({
        Title = "Background Blur", Content = "Blur di belakang UI saat terbuka", Default = self.BlurEnabled, Flag = "Claux_Blur",
        Callback = function(v)
            Window.BlurEnabled = v
            Claux:_UpdateBlur()
        end,
    })
    I:AddToggle({ Title = "Notifications", Default = true, Flag = "Claux_Notifs", Callback = function(v) Claux.NotificationsEnabled = v end })
    I:AddToggle({ Title = "Watermark", Default = false, Flag = "Claux_Watermark", Callback = function(v) Claux:SetWatermark(v, Window.Title) end })
    I:AddToggle({ Title = "Keybind List", Default = false, Flag = "Claux_KeybindList", Callback = function(v) Claux:SetKeybindList(v) end })
    I:AddButton({ Title = "Unload UI", Content = "Tutup dan hapus UI sepenuhnya", Text = "Unload", Callback = function()
        Claux:Confirm("Unload " .. Window.Title, "UI akan di-unload sepenuhnya. Config tetap tersimpan.", "Unload", function() Claux:Unload() end)
    end })

    return Tab
end

----------------------------------------------------------------------
-- Unload
----------------------------------------------------------------------
function Claux:Unload()
    pcall(function() self:SaveConfig(true) end)
    for _, c in ipairs(self.Connections) do
        pcall(function() c:Disconnect() end)
    end
    self.Connections = {}
    if self.Blur then pcall(function() self.Blur:Destroy() end) end
    if self.Gui then pcall(function() self.Gui:Destroy() end) end
    self.Gui, self.Blur, self.Watermark, self.KeybindFrame = nil, nil, nil, nil
    self.Windows, self.Keybinds, self.Elements, self.Flags = {}, {}, {}, {}
    self.Listening, self.CurrentPopup = nil, nil
    ActiveNotifs = {}
    ActiveDrag, ActiveDragPage = nil, nil
    for i = #ThemeBindings, 1, -1 do table.remove(ThemeBindings, i) end
    for i = #ThemeCallbacks, 1, -1 do table.remove(ThemeCallbacks, i) end
    if genv.Claux == self then genv.Claux = nil end
end

genv.Claux = Claux
return Claux
